{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@images/*": ["./src/assets/images/*"],
      "@consts": ["./src/consts"],
      "@components/*": ["./src/components/*"],
      "@styles/*": ["./src/styles/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@standalone-content/*": ["./src/standalone-content/*"]
    }
  }
}
