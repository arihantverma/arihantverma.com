---
import "@styles/jc-reset.css";
import "@styles/global.css";

import type { ImageMetadata } from "astro";

import Header from "@components/astro/Header.astro";
import { SITE_TITLE } from "@consts";
import Footer from "@components/astro/Footer.astro";
import { Font } from "astro:assets";

type SocialImage = ImageMetadata | string;

interface Props {
  // Required for production-ready SEO. Every page should set these intentionally.
  title: string;
  description: string;

  // Optional because they can be inferred safely or are page-specific overrides.
  lang?: string;
  canonicalUrl?: string | URL;
  image?: SocialImage;
  robots?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  lang = "en",
  canonicalUrl,
  image,
  robots = "index,follow",
  ogType = "website",
} = Astro.props;

const siteOrigin = Astro.site ?? Astro.url;
const canonicalHref = new URL(canonicalUrl ?? Astro.url.pathname, siteOrigin);
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const socialImageUrl = image
  ? new URL(typeof image === "string" ? image : image.src, siteOrigin)
  : undefined;
---

<!doctype html>
<html lang={lang} class="bg-riri-background">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalHref} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL("/rss.xml", siteOrigin)}
    />

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}

    <!-- Uncomment after adding browser theming colors. -->
    <!-- <meta name="theme-color" content="#ffffff" /> -->

    <!-- Uncomment after adding a web app manifest. -->
    <!-- <link rel="manifest" href="/site.webmanifest" /> -->

    <!-- Uncomment after defining social account metadata. -->
    <!-- <meta name="twitter:site" content="@yourhandle" /> -->
    <!-- <meta name="twitter:creator" content="@yourhandle" /> -->

    <!-- Uncomment if you want locale-specific social metadata. -->
    <!-- <meta property="og:locale" content="en_US" /> -->

    <!-- Uncomment on article-like pages once publish/update dates exist. -->
    <!-- <meta property="article:published_time" content="2026-04-17T00:00:00.000Z" /> -->
    <!-- <meta property="article:modified_time" content="2026-04-17T00:00:00.000Z" /> -->

    <!-- Uncomment when you add page-level structured data. -->
    <!-- <script type="application/ld+json">{JSON.stringify({})}</script> -->

    <Font cssVariable="--astro-font-playwrite-nz-guides" />

    <slot name="head" />
  </head>
  <body>
    <div>
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-black"
      >
        Skip to content
      </a>

      <Header />

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>
