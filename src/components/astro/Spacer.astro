---
import clsx from "clsx";
import type { HTMLAttributes } from "astro/types";

const spacerSizes = [
  "3xs",
  "2xs",
  "xs",
  "sm",
  "md",
  "lg",
  "xl",
  "2xl",
] as const;

type SpacerSize = (typeof spacerSizes)[number];
type SpacerAxis = "horizontal" | "vertical" | "square";

interface Props {
  axis?: SpacerAxis;
  class?: string;
  inline?: boolean;
  size?: SpacerSize;
  space?: string;
  style?: HTMLAttributes<"span">["style"];
}

function toKebabCase(value: string) {
  return value.replace(/[A-Z]/g, (character) => `-${character.toLowerCase()}`);
}

function toStyleString(style: Props["style"]) {
  if (!style) {
    return "";
  }

  if (typeof style === "string") {
    return style;
  }

  return Object.entries(style)
    .map(([property, value]) => `${toKebabCase(property)}: ${value};`)
    .join(" ");
}

const {
  axis = "square",
  class: className,
  inline = false,
  size = "md",
  space,
  style,
} = Astro.props;

const spacerSize = space ?? `var(--spacing-spacer-${size})`;
const spacerWidth = axis === "vertical" ? "1px" : spacerSize;
const spacerHeight = axis === "horizontal" ? "1px" : spacerSize;
const styleAttr = [
  `width: ${spacerWidth};`,
  `min-width: ${spacerWidth};`,
  `height: ${spacerHeight};`,
  `min-height: ${spacerHeight};`,
  toStyleString(style),
]
  .filter(Boolean)
  .join(" ");
---

<span
  aria-hidden="true"
  class={clsx(inline ? "inline-block" : "block", className)}
  style={styleAttr}></span>
